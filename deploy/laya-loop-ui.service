# Laya 工业决策回路 Web UI (loop_ui.py, 127.0.0.1:8002)
# 安装: cp deploy/laya-loop-ui.service ~/.config/systemd/user/
#       systemctl --user daemon-reload
#       systemctl --user enable --now laya-loop-ui
# 日志: journalctl --user -u laya-loop-ui -f
[Unit]
Description=Laya industrial decision loop web UI (port 8002)
After=network-online.target laya-jev-api.service laya-sort-gateway.service
Wants=laya-jev-api.service laya-sort-gateway.service

[Service]
WorkingDirectory=/home/rockets/laya-industrial-bench
ExecStart=/home/rockets/laya-industrial-bench/.venv/bin/python loop_ui.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
