# Ollama 本地 LLM (qwen3.5:4b, 校验拒绝时的旁路模型)
# 模型在 ~/.ollama (用户级), 所以用用户服务跑, 无需 root.
# 若以后启用了系统级 ollama.service, 二者会争 11434 端口, 留其一.
# 安装: cp deploy/ollama-serve.service ~/.config/systemd/user/
#       systemctl --user daemon-reload
#       systemctl --user enable --now ollama-serve
# 日志: journalctl --user -u ollama-serve -f
[Unit]
Description=Ollama local LLM server (127.0.0.1:11434)
After=network.target

[Service]
ExecStart=/usr/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
