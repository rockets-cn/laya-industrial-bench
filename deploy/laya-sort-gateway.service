# MQTT 分拣网关 (sort_mqtt.py) HTTP :8123, 连 broker tcp://127.0.0.1:1883
# 指令源: 收 sort/inbound/{command,vision} -> 下发 sort/sorter{n}/cmd + 透传遥测/运动 -> 孪生 /twin.
# 依赖 broker 先起 (After=); 网关自带 MQTT 重连, broker 重启后自动回连.
# 安装: cp deploy/laya-sort-gateway.service ~/.config/systemd/user/
#       systemctl --user daemon-reload
#       systemctl --user enable --now laya-sort-gateway
# 日志: journalctl --user -u laya-sort-gateway -f
[Unit]
Description=Laya sort MQTT gateway (HTTP :8123)
After=network-online.target laya-mqtt-broker.service
Wants=laya-mqtt-broker.service

[Service]
WorkingDirectory=/home/rockets/laya-industrial-bench
ExecStart=/home/rockets/laya-industrial-bench/.venv/bin/python sort_mqtt.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
